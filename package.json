{
  "name": "gymlog",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "Registro de entrenamientos personal (estilo Strong). React + Mantine en el frontend, funciones serverless en Vercel.",
  "scripts": {
    "dev": "node dev-server.js",
    "build": "vite build",
    "preview": "npm run build && node dev-server.js --dist",
    "test": "node --test test/*.test.js",
    "test:e2e": "vite build && node test/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/charts": "^9.8.1",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/modals": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.58",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
