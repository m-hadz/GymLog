# Copia este archivo a .env para desarrollo local (opcional).
# Sin SUPABASE_* el servidor local guarda todo en ./data/dev-db.json
APP_PASSWORD=cambia-esta-clave
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Resumen diario de YouTube ("Lectura del día") ---
# ID del canal (empieza con UC), no el @handle
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Transcripciones (plan Free: 100 créditos/mes)
SUPADATA_API_KEY=sd_xxxxxxxx
# Resumen
OPENAI_API_KEY=sk-xxxxxxxx
# Opcional (por defecto gpt-5-mini)
OPENAI_MODEL=gpt-5-mini
# Vercel la manda sola en el header Authorization del cron. Generar: openssl rand -hex 24
CRON_SECRET=una-cadena-aleatoria-larga

# --- Aviso de fin de descanso con la app cerrada (feature 11) ---
# Generar con: node scripts/vapid-keys.mjs  (la privada no se comparte)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: mailto: o https:// (por defecto, la URL de la app)
VAPID_SUBJECT=
